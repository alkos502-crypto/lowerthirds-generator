<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest ExtensionBundleId="com.multitool.lowerthirds.v1" ExtensionBundleVersion="1.0.0" Version="8.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.multitool.lowerthirds.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
